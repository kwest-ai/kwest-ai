# Google Form (recommended for GitHub Pages static sites)
# Create a Google Form with fields: Name, Email, Phone, Message
# In the form's "Send" page, open the form in your browser and inspect the input names
# The form POST endpoint looks like: https://docs.google.com/forms/d/e/<FORM_ID>/formResponse
# Each input has a name like entry.<ENTRY_ID>

# Full action URL for your Google Form (copy the formResponse URL)
NEXT_PUBLIC_GOOGLE_FORM_ACTION=https://docs.google.com/forms/d/e/your_form_id/formResponse

# The entry IDs for your form fields (replace with actual entry.<id> values)
NEXT_PUBLIC_GOOGLE_ENTRY_NAME=entry.1234567890
NEXT_PUBLIC_GOOGLE_ENTRY_EMAIL=entry.0987654321
NEXT_PUBLIC_GOOGLE_ENTRY_PHONE=entry.1122334455
NEXT_PUBLIC_GOOGLE_ENTRY_MESSAGE=entry.6677889900

# Notes:
# - Use the browser devtools to find the correct entry IDs for each field.
# - Google Forms does not support CORS, so submissions use fetch with `mode: "no-cors"`.
#   The request is sent but the response will be opaque; we treat it as success.
# - This approach stores responses in the linked Google Sheet automatically.

