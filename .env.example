# Resend API Configuration for Contact Form
# Get your API key from https://resend.com/api-keys
# Use a public API key for client-side usage (safe for GitHub Pages)
NEXT_PUBLIC_RESEND_API_KEY=your_resend_api_key_here

# Note: NEXT_PUBLIC_ prefix makes this available in the browser
# This is safe because Resend's free tier allows public API keys with domain restrictions

